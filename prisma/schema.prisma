generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  name         String?
  imageUrl     String?
  password     String?
  isAdmin      Boolean            @default(false)
  accountStatus String             @default("ACTIVE")
  tokenVersion  Int                @default(0)
  lastLoginAt   DateTime?
  emailVerifiedAt DateTime?
  termsAcceptedAt DateTime?
  legalVersion    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  simulados    Simulado[]
  monthlyUsage MonthlyUsage[]
  tentativas   Tentativa[]
  feedbacks    QuestionFeedback[]
  authTokens   AuthToken[]
  subscription Subscription?
  paymentEvents PaymentEvent[]
  studyPlanProgress StudyPlanProgress[]
  reviewCards ReviewCard[]
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider               String    @default("NUVEMSHOP")
  planCode               String    @default("FREE")
  status                 String    @default("PENDING")
  billingInterval        String?
  providerSubscriptionId String?   @unique
  providerCustomerId     String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  lastPaidAt             DateTime?
  canceledAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([status])
  @@index([planCode])
  @@index([currentPeriodEnd])
}

model PaymentEvent {
  id              String    @id @default(cuid())
  provider        String    @default("NUVEMSHOP")
  eventKey        String    @unique
  eventType       String
  providerOrderId String?
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  status          String    @default("RECEIVED")
  metadata        String?
  errorMessage    String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([provider, eventType])
  @@index([providerOrderId])
  @@index([userId])
  @@index([createdAt])
}

model MonthlyUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthKey  String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, monthKey])
  @@index([userId, monthKey])
}

model Simulado {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  titulo        String
  totalQuestoes Int                @default(30)
  temasFoco     String?
  pdfNome       String
  pdfHash       String
  questoesJson  String
  difficultyTarget String         @default("MISTO")
  ocrUsed       Boolean            @default(false)
  status        String             @default("NAO_INICIADO")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  tentativas    Tentativa[]
  feedbacks     QuestionFeedback[]
  reviewCards   ReviewCard[]
  deletedAt     DateTime?

  @@index([userId, pdfHash])
  @@index([userId])
  @@index([createdAt])
  @@index([pdfHash])
}

model StudyPlanProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekKey     String
  taskKey     String
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, weekKey, taskKey])
  @@index([userId, weekKey])
}

model ReviewCard {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  simuladoId     String
  simulado       Simulado  @relation(fields: [simuladoId], references: [id], onDelete: Cascade)
  questionId     Int
  questionJson   String
  lastAnswer     String?
  repetitions    Int       @default(0)
  intervalDays   Int       @default(1)
  easeFactor     Float     @default(2.5)
  dueAt          DateTime  @default(now())
  lastReviewedAt DateTime?
  masteredAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, simuladoId, questionId])
  @@index([userId, dueAt])
  @@index([userId, masteredAt])
}

model Tentativa {
  id              String    @id @default(cuid())
  activeKey       String?   @unique
  simuladoId      String
  simulado        Simulado  @relation(fields: [simuladoId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  respostas       String
  pontuacao       Int
  totalQuestoes   Int
  percentual      Float
  currentIndex    Int       @default(0)
  selectedAnswers String?
  concluidoEm     DateTime?
  durationSeconds Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([simuladoId])
  @@index([userId])
  @@index([concluidoEm])
}

model AuditLog {
  id              String   @id @default(cuid())
  userId          String?
  action          String
  provider        String?
  durationMs      Int?
  tokensEstimated Int?
  status          String
  errorMessage    String?
  metadata        String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model QuestionFeedback {
  id         String   @id @default(cuid())
  simuladoId String
  questaoId  Int
  userId     String
  type       String
  message    String?
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  simulado Simulado @relation(fields: [simuladoId], references: [id], onDelete: Cascade)

  @@index([simuladoId, questaoId])
}

model PendingInvite {
  id        String   @id @default(cuid())
  email     String   @unique
  token     String   @unique
  name      String?
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([token])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  targetUserId String?
  action       String
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}
