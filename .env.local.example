# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL do Supabase para Prisma e Vercel
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA_REAL@POOLER_HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:SENHA_REAL@POOLER_HOST:5432/postgres"
SUPABASE_DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA_REAL@POOLER_HOST:6543/postgres"
CRON_SECRET=
APP_TIMEZONE=America/Fortaleza

# Único provedor de geração
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# Embeddings locais na CPU
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Processamento de PDFs extensos em lotes + pgvector
SUPABASE_URL=your_supabase_project_url
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Alternativa sem chave secreta: use as duas variáveis públicas abaixo e
# ative a integração Clerk em Supabase Third-party auth + migration 002.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Alternativa legada à Secret Key. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Conta de desenvolvimento sem limite mensal. Deixe em branco em produção.
CLERK_DEV_USER_ID=
CLERK_DEV_USER_EMAIL=
