NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pooler do Supabase. Use a URL de transação em DATABASE_URL na Vercel.
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA_REAL@POOLER_HOST:6543/postgres?pgbouncer=true"
# Use a conexão direta ou session pooler para migrations.
DIRECT_URL="postgresql://postgres.PROJECT_REF:SENHA_REAL@POOLER_HOST:5432/postgres"
APP_TIMEZONE=America/Fortaleza

OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Opcional: ativa extração do PDF no navegador e vetores persistidos por lote.
# Use uma Secret Key nova do Supabase ou, em projetos antigos, a service_role.
# O backend aceita a URL pública abaixo ou SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Usada pelos scripts administrativos de migrations e ingestão.
SUPABASE_DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA_REAL@POOLER_HOST:6543/postgres"
CRON_SECRET=

# Conta de desenvolvimento sem limite mensal. Deixe em branco em produção.
CLERK_DEV_USER_ID=
CLERK_DEV_USER_EMAIL=
